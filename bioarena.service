[Unit]
Description=Bioarena practice server
# network-online.target waits for IP assignment; network.target fires too early.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# A dedicated system account, not a login user. Raspberry Pi OS no longer creates "pi" by
# default, and naming whichever account happens to exist here makes the field controller
# depend on how the SD card was flashed. See "Install" in the README for the useradd.
User=bioarena
WorkingDirectory=/opt/bioarena

# CAP_NET_ADMIN covers "ip addr add" below, and the VLAN subinterfaces and ip_forward that
# team_network_driver: local configures -- the kernel grants CAP_NET_ADMIN holders root's
# access under /proc/sys/net. It does not cover restarting dnsmasq, which systemd
# authorises over D-Bus; see the polkit rule in the README.
AmbientCapabilities=CAP_NET_ADMIN

# Assign the FMS address to eth0 before starting.
# The leading '-' tells systemd to ignore the error if the address is
# already configured (e.g. after a service restart).
ExecStartPre=-/sbin/ip addr add 10.0.100.5/24 dev eth0

# A second address in the access point's backup subnet. The Vivid-Hosting AP normally lives
# at 10.0.100.2, which the address above already reaches -- but it also answers on
# 192.168.69.1, and that is where it is found after a reset or a failed firmware write.
# Holding an address there keeps that fallback usable from the field instead of needing a
# laptop cabled straight to the AP. Same VLAN as this interface, so no routing, no gateway.
ExecStartPre=-/sbin/ip addr add 192.168.69.5/24 dev eth0

# A route back to everything the switch routes to us. The driver stations live on the
# subnets the switch owns, 10.TE.AM.0/24 per team, and their packets arrive here fine.
# Without this the replies have nowhere to go: the TCP handshake never completes, so a
# driver station sits connected to a field that never acknowledges it.
#
# There is deliberately no default route. The field has no path to the internet, and a
# default here would send this Pi's own traffic into it.
#
# 10.0.100.0/24 stays local because a connected route is more specific than 10.0.0.0/8, and
# on team_network_driver: local the per-VLAN subinterfaces are likewise more specific, so
# these are inert there rather than wrong.
ExecStartPre=-/sbin/ip route add 10.0.0.0/8 via 10.0.100.3 dev eth0

# The binary is made executable at deploy time, by the account that copied it. Doing it
# here instead fails: this unit runs as bioarena, chmod requires ownership, and the
# deployed files belong to whoever ran the scp.
ExecStart=/opt/bioarena/bioarena-pi
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
